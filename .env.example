# Copy to .env, or run `npm run setup` to make one with random values.

# Presenter sign-in at /admin. Both are required, or nobody can sign in to build decks.
ADMIN_PASSWORD=change-me
# 16 characters or more. Changing it signs the presenter out.
SESSION_SECRET=replace-with-a-long-random-string

# The port the server listens on.
# PORT=3000

# Where decks, photos and saved games live when S3 isn't set. Defaults to .data.
# DATA_DIR=.data

# S3 storage, for hosts whose containers lose their disk on each deploy.
# Leave S3_ENDPOINT_URL out for Amazon S3. Set it for MinIO, Cloudflare R2 and the like.
# S3_BUCKET=presentation-game
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://localhost:9000

# Let anyone make a space with a join code, with no account. For a public server.
# HOSTED=true

# How much disk the local copy of photos and videos may use, in MB. Defaults to 2048.
# MEDIA_CACHE_MB=2048
